# =============================================================================
# Developer Command Center — example environment
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Public base URL of the DCC (used for cookies, CSRF origin checks and PWA).
# On Render this can be omitted: RENDER_EXTERNAL_URL is used automatically.
# Set it explicitly once you attach a custom domain.
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://dcc:dcc@localhost:5432/dcc?schema=public

# --- Authentication -----------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# --- Mock mode ----------------------------------------------------------
# When true the platform serves simulated data and never needs Docker,
# Postgres monitoring targets or external APIs (spec §33).
MOCK_MODE=true

# --- Monitoring ---------------------------------------------------------
# Health check interval in seconds (spec §7)
MONITORING_INTERVAL_SECONDS=30
MONITORING_TIMEOUT_MS=5000

# --- Retention and downsampling (spec §36) -------------------------------
# Runs only when MOCK_MODE is off — there is nothing to clean up in mock mode.
RETENTION_INTERVAL_HOURS=24
SERVICE_CHECK_RETENTION_DAYS=30
METRIC_DOWNSAMPLE_AFTER_HOURS=24
METRIC_RETENTION_DAYS=90
# UI polling interval in seconds (spec §31)
NEXT_PUBLIC_POLL_INTERVAL_SECONDS=30

# --- Optional integrations (leave empty to disable) ---------------------
# When set, the rate limiter and the GitHub-repositories cache use Redis
# instead of in-memory storage — the only difference this makes is that both
# are shared across instances instead of per-instance. Everything works
# without it on a single-container deployment.
REDIS_URL=
GITHUB_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_MAX_ATTEMPTS=5
# Login requests per minute per IP (shared NAT / test runners may need more)
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_LOCKOUT_MINUTES=15

# --- First-run administrator -------------------------------------------
# Created automatically on server start when the account does not exist yet.
# An existing account is never modified, so this cannot be used to reset a
# password. There is no default: leave these empty and no account is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Command Center Admin

# --- Seed script (only used by `npm run db:seed`) ----------------------
SEED_ADMIN_EMAIL=admin@dcc.local
SEED_ADMIN_PASSWORD=
